<IfModule mime_module>
        RemoveHandler .php .phtml .php3 .php4 .php5 .php6
        RemoveType .php .phtml .php3 .php4 .php5 .php6
</IfModule>
<IfModule !mime_module>
        <Files ~ "\.(php[3456]?|phtml)$">
                Order allow,deny
                Deny from all
        </Files>
</IfModule>
<IfModule mod_authz_core.c>
        <FilesMatch "\.(php[0-9]*|phtml|phar)$">
                Require all denied
        </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
        <FilesMatch "\.(php[0-9]*|phar)$">
                Order allow,deny
                Deny from all
        </FilesMatch>
</IfModule>
